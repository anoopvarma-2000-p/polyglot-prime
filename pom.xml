<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.techbd</groupId>
    <artifactId>polyglot-prime</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>Polyglot Prime</name>
    <description>Parent Project for Polyglot Prime</description>

    <modules>
        <module>hub-prime</module>
        <module>nexus-core-lib</module>
        <module>nexus-ingestion-api</module>
        <module>fhir-validation-service</module>
        <module>csv-service</module>
    </modules>

    <properties>
        <revision>0.2122.0</revision>
        <java.version>21</java.version>
        <spring-boot.version>3.5.16</spring-boot.version>
        <aws.sdk.version>2.59.4</aws.sdk.version>
        <tomcat.version>10.1.62</tomcat.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              Security pins for transitive libraries (AWS Inspector findings).
              Entries declared before the Spring Boot BOM take precedence over it.
            -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <!-- via commons-vfs2-spring-boot-starter 1.0.1-RELEASE (ships 2.7.0) -->
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-vfs2</artifactId>
                <version>2.10.0</version>
            </dependency>
            <dependency>
                <!-- via oauth2-oidc-sdk 10.8 / spring-security-oauth2-jose; stay on the 9.x line -->
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>9.48</version>
            </dependency>
            <dependency>
                <!-- via HAPI FHIR / OpenTelemetry -->
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.8.0-jre</version>
            </dependency>
            <dependency>
                <!--
                  Only consumer is opentelemetry-proto (via micrometer-registry-otlp), which is generated for
                  protobuf 4.x (needs >= 4.28.3, uses com.google.protobuf.RuntimeVersion). Do not pin to 3.x.
                -->
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>4.36.2</version>
            </dependency>
            <dependency>
                <!-- via Thymeleaf (Spring apps evaluate SpEL, OGNL is not used at runtime) -->
                <groupId>ognl</groupId>
                <artifactId>ognl</artifactId>
                <version>3.4.17</version>
            </dependency>
            <dependency>
                <!-- via opencsv 5.8 (ships 1.9.4) -->
                <groupId>commons-beanutils</groupId>
                <artifactId>commons-beanutils</artifactId>
                <version>1.11.0</version>
            </dependency>
            <!--
              Overrides of versions managed by the Spring Boot BOM: the BOM is imported (not the parent),
              so <tomcat.version>-style properties do not apply; explicit entries above the import win.
            -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>4.1.141.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <!-- okhttp 5.x (OTLP exporter sender, via OpenTelemetry 1.68) needs okio >= 3.18.1; keeps okio and okio-jvm aligned -->
                <groupId>com.squareup.okio</groupId>
                <artifactId>okio-bom</artifactId>
                <version>3.18.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <!-- aligns API, SDK, exporters and autoconfigure on one version -->
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>1.68.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-bom</artifactId>
                <version>2.25.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.22.0</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-parent</artifactId>
                <version>${spring-boot.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.5.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
